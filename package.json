{
  "name": "pagecurl-gl",
  "version": "0.0.0",
  "description": "Page-curl page turns for React frontends, rendered with WebGL2 fragment-shader deformation.",
  "keywords": [
    "3d",
    "flipbook",
    "page-curl",
    "page-flip",
    "pdf",
    "react",
    "webgl"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
